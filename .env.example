# FSC — Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com valores reais
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=fsc_user
POSTGRES_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI
POSTGRES_DB=fsc_db

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# Redis
REDIS_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# LocalStack (simulado — usar apenas em dev)
AWS_ACCESS_KEY_ID=fsc_local_key
AWS_SECRET_ACCESS_KEY=COLOQUE_UMA_CHAVE_AQUI
